<view class="page">
  <view class="anchor-bar" wx:if="{{anchors.length}}">
    <scroll-view class="anchor-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{anchors}}"
        wx:key="gid"
        class="anchor-item {{activeGid === item.gid ? 'active' : ''}}"
        bindtap="onAnchor"
        data-gid="{{item.gid}}"
      >{{item.name}}</view>
    </scroll-view>
  </view>

  <scroll-view class="feed" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced>
    <view wx:if="{{loading}}" class="skeleton">
      <view class="sk-card" wx:for="{{skCards}}" wx:key="id">
        <view class="sk-line sk-title"></view>
        <view class="sk-line" wx:for="{{item.rows}}" wx:for-item="row" wx:key="*this"></view>
      </view>
    </view>

    <view wx:elif="{{error}}" class="tip">{{error}}</view>

    <block wx:else>
      <block wx:for="{{blocks}}" wx:for-item="blk" wx:key="key">
        <view wx:if="{{blk.type === 'group'}}" id="g-{{blk.gid}}" class="group-title">
          <view class="group-mark"></view>
          <text>{{blk.name}}</text>
        </view>
        <cat-block
          wx:elif="{{blk.type === 'cat'}}"
          gid="{{blk.gid}}"
          cat-key="{{blk.catKey}}"
          name="{{blk.name}}"
          icon-color="{{blk.iconColor}}"
          total="{{blk.total}}"
          items="{{blk.items}}"
          bind:more="onMore"
          bind:open="onOpen"
        />
        <ad-slot
          wx:elif="{{blk.type === 'ad'}}"
          slot-id="{{blk.slotId}}"
          tag="{{blk.tag}}"
          title="{{blk.title}}"
          desc="{{blk.desc}}"
          image="{{blk.image}}"
          path="{{blk.path}}"
          bind:open="onOpenAd"
        />
      </block>
      <view class="tip footer-tip">{{dataHint || '标题和热度来自公开热榜'}}</view>
    </block>
  </scroll-view>
</view>
