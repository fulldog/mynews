@import "../../styles/theme.wxss";

.cat-block {
  background: var(--card);
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.cat-head {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 8rpx;
}

.cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex: none;
}

.cat-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.cat-more {
  flex: none;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
