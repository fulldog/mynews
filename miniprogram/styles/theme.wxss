/* 组件内再定义一遍，避免样式隔离吃掉 page 上的变量 */
.theme-root {
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1a1a1a;
  --text-strong: #111111;
  --text-secondary: #666666;
  --text-muted: #888888;
  --text-read: #b5b5b5;
  --border: #ececec;
  --hairline: #f2f2f2;
  --chip: #f2f3f5;
  --hover: #fafafa;
  --skeleton: #eeeeee;
  --accent: #ff6a00;
  --hot: #ff5722;
  --ad-bg: linear-gradient(135deg, #fff6ee, #ffe8d6);
  --ad-title: #7a3d10;
  --ad-desc: #8a5a32;
  --ad-tag: #e8894a;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", "Noto Serif SC", serif;
  color: var(--text);
}

@media (prefers-color-scheme: dark) {
  .theme-root {
    --bg: #000000;
    --card: #1c1c1e;
    --text: #f2f2f7;
    --text-strong: #ffffff;
    --text-secondary: #aeaeb2;
    --text-muted: #8e8e93;
    --text-read: #636366;
    --border: #2c2c2e;
    --hairline: #2c2c2e;
    --chip: #2c2c2e;
    --hover: #2c2c2e;
    --skeleton: #3a3a3c;
    --accent: #ff6a00;
    --hot: #ff6b3d;
    --ad-bg: linear-gradient(135deg, #3a2a1c, #2c2118);
    --ad-title: #ffd2a6;
    --ad-desc: #c9a07a;
    --ad-tag: #e8894a;
  }
}
